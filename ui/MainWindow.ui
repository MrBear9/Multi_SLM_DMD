  <property name="styleSheet">
   <string>
QMainWindow, QWidget#centralWidget { background: #f3f6fb; }
QWidget { font-family: "Microsoft YaHei UI", "Microsoft YaHei", sans-serif; font-size: 12px; color: #26354b; }
QLabel#titleLabel { font-size: 24px; font-weight: 600; color: #13243b; }
QLabel#subtitleLabel, QLabel#sessionHintLabel, QLabel#previewHintLabel { color: #687b92; }
QLabel#connectionStateLabel { color: #62758d; background: #e6ecf5; border-radius: 12px; padding: 8px 14px; }
QTabWidget::pane { border: 1px solid #d9e2ed; background: #f8fafc; border-radius: 8px; }
QTabBar::tab { background: #e8eef6; color: #60728b; padding: 12px 30px; margin-right: 6px; border-top-left-radius: 7px; border-top-right-radius: 7px; font-weight: 600; }
QTabBar::tab:selected { background: #ffffff; color: #2468d4; border-bottom: 3px solid #3478ed; }
QGroupBox { background: #ffffff; border: 1px solid #dbe3ef; border-radius: 8px; margin-top: 14px; padding: 14px 10px 10px 10px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; left: 14px; padding: 0 6px; color: #274569; }
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox { background: #fbfcff; border: 1px solid #ccd7e5; border-radius: 5px; padding: 5px 8px; min-height: 20px; selection-background-color: #3478ed; }
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border: 1px solid #3478ed; }
QPushButton { background: #ffffff; border: 1px solid #cdd8e7; border-radius: 5px; padding: 7px 14px; }
QPushButton:hover { background: #edf4ff; border-color: #8db3ed; }
QPushButton:pressed { background: #dceaff; }
QPushButton:disabled { color: #98a5b7; background: #f4f6f9; border-color: #e0e6ee; }
QPushButton#connectDevicesButton, QPushButton#startAllButton { background: #286bdb; color: white; border-color: #286bdb; font-weight: 600; }
QPushButton#startAllButton:disabled { background: #c4d5f0; border-color: #c4d5f0; color: #f7faff; }
QPushButton#stopAllButton { color: #b44b57; border-color: #e7c3c9; }
QLabel#dmdPreviewLabel, QLabel#slm1PreviewLabel, QLabel#slm2PreviewLabel, QLabel#ccdPreviewLabel { background: #101b2b; color: #8ea4c0; border: 1px solid #263b55; border-radius: 6px; font-size: 15px; }
QCheckBox { spacing: 7px; }
QScrollArea { border: none; background: transparent; }
QWidget#configurationScrollContents, QWidget#previewScrollContents { background: #f8fafc; }
QStatusBar { background: #eaf0f7; color: #647790; }

QFrame#dmdPreviewCard, QFrame#slm1PreviewCard, QFrame#slm2PreviewCard, QFrame#ccdPreviewCard { background: white; border: 1px solid #d8e2ef; border-radius: 10px; }
QLabel#dmdTitleLabel, QLabel#slm1TitleLabel, QLabel#slm2TitleLabel, QLabel#ccdTitleLabel { font-size: 14px; font-weight: 600; color: #203958; }
QLabel#dmdBadgeLabel, QLabel#slm1BadgeLabel, QLabel#slm2BadgeLabel, QLabel#ccdBadgeLabel { background: #eaf1fb; color: #3168ae; border-radius: 4px; padding: 4px 0; qproperty-alignment: AlignCenter; font-weight: 600; }
QLabel#dmdStateLabel, QLabel#slm1StateLabel, QLabel#slm2StateLabel, QLabel#ccdStateLabel { color: #608078; font-size: 11px; }
QLabel#dmdPanelInfoLabel, QLabel#slm1PanelInfoLabel, QLabel#slm2PanelInfoLabel, QLabel#ccdPanelInfoLabel, QLabel#dmdActiveAreaLabel, QLabel#slm1ActiveAreaLabel, QLabel#slm2ActiveAreaLabel, QLabel#ccdActiveAreaLabel { color: #65788f; font-size: 11px; }
QLabel#dmdFrameInfoLabel, QLabel#slm1FrameInfoLabel, QLabel#slm2FrameInfoLabel, QLabel#ccdFrameInfoLabel { color: #536b86; font-size: 11px; }
QLabel#previewHintLabel { font-size: 14px; font-weight: 600; color: #29476b; }
QLabel#dmdOutputHintLabel, QLabel#slm2OutputHintLabel { color: #7e8ea2; font-size: 11px; }
QFrame#dmdPreviewCard QPushButton, QFrame#slm1PreviewCard QPushButton, QFrame#slm2PreviewCard QPushButton, QFrame#ccdPreviewCard QPushButton { padding: 5px 4px; }

QWidget#dmdControlsWidget, QWidget#slm1ControlsWidget, QWidget#slm2ControlsWidget, QWidget#ccdControlsWidget { background: transparent; }
QWidget#dmdControlsWidget QComboBox, QWidget#slm1ControlsWidget QComboBox, QWidget#slm2ControlsWidget QComboBox, QWidget#ccdControlsWidget QComboBox { min-height: 18px; padding: 4px 7px; }
QWidget#dmdControlsWidget QSpinBox, QWidget#slm1ControlsWidget QSpinBox, QWidget#slm2ControlsWidget QSpinBox, QWidget#ccdControlsWidget QDoubleSpinBox { min-height: 18px; padding: 4px 5px; }
</string>
