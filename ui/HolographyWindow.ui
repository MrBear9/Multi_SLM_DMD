         <widget class="QWidget" name="feedbackPage">
          <attribute name="title">
           <string>回环与模型</string>
          </attribute>
          <layout class="QVBoxLayout" name="feedbackPageLayout">
           <item>
            <widget class="QGroupBox" name="feedbackGroup">
             <property name="title">
              <string>实拍接受与模型校正</string>
             </property>
             <layout class="QGridLayout" name="feedbackGrid">
              <item row="0" column="0" colspan="2">
               <widget class="QCheckBox" name="feedback_auto_calibrate">
                <property name="text">
                 <string>无模型时先自动标定</string>
                </property>
                <property name="checked">
                 <bool>true</bool>
                </property>
                <property name="toolTip">
                 <string>未载入模型时先采集和拟合；验证未通过将停止回环。</string>
                </property>
               </widget>
              </item>
              <item row="0" column="2" colspan="2">
               <widget class="QCheckBox" name="feedback_online_model">
                <property name="text">
                 <string>回环中更新模型</string>
                </property>
                <property name="checked">
                 <bool>false</bool>
                </property>
                <property name="toolTip">
                 <string>按实拍修正模型，只有验证改善才替换；与相位更新分开进行。</string>
                </property>
               </widget>
              </item>
              <item row="1" column="0" colspan="2">
               <widget class="QCheckBox" name="model_background">
                <property name="text">
                 <string>学习平滑背景光场</string>
                </property>
                <property name="checked">
                 <bool>true</bool>
                </property>
                <property name="toolTip">
                 <string>包含低分辨率相干附加光场和非相干背景；不代表唯一测出了零级光。</string>
                </property>
               </widget>
              </item>
              <item row="1" column="2">
               <widget class="QLabel" name="feedback_verify_repeatsLabel">
                <property name="text">
                 <string>每个候选复拍次数</string>
                </property>
               </widget>
              </item>
              <item row="1" column="3">
               <widget class="QSpinBox" name="feedback_verify_repeats">
                <property name="minimum">
                 <number>1</number>
                </property>
                <property name="maximum">
                 <number>5</number>
                </property>
                <property name="value">
                 <number>2</number>
                </property>
                <property name="keyboardTracking">
                 <bool>false</bool>
                </property>
                <property name="toolTip">
                 <string>每次复拍内部仍使用成像与采集的平均帧数。</string>
                </property>
               </widget>
              </item>
              <item row="2" column="0">
               <widget class="QLabel" name="feedback_max_retriesLabel">
                <property name="text">
                 <string>每步最多缩步重试</string>
